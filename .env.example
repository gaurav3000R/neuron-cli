# AI Providers API Keys
# You only need to set the ones for the providers you intend to use.

# OpenAI (required if provider is openai)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Google Gemini (required if provider is gemini)
GEMINI_API_KEY=AIzaSy-your-gemini-key-here

# Hugging Face (required if provider is huggingface or hf)
HUGGINGFACE_API_KEY=hf_your-huggingface-key-here
# Alternatively you can use HF_TOKEN
# HF_TOKEN=hf_your-huggingface-token-here

# Fallback generic API key used if not explicitly defined above
NEURON_LLM_API_KEY=your-api-key-here

# Slack Bot Configuration (required for the `slack` command)
# Get these by creating an app at https://api.slack.com/apps and enabling Socket Mode
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-level-token
